+  HRESULT STDMETHODCALLTYPE SubmitWindowsVRFrame(const WVRDXMTD3D12SubmitFrameV1 *frame) final {
+    if (!frame || !frame->left || !frame->right || frame->left == frame->right || !frame->targetGeneration)
+      return E_INVALIDARG;
+
+    WVRDXMTTargetInfoV1 targets{};
+    if (FAILED(GetWindowsVRTargets(&targets)) || targets.generation != frame->targetGeneration)
+      return DXGI_ERROR_INVALID_CALL;
+
+    auto belongs_to_queue_device = [this](ID3D12Resource *resource) {
+      void *device_object = nullptr;
+      if (FAILED(resource->GetDevice(__uuidof(ID3D12Device), &device_object)) || !device_object)
+        return false;
+      auto *resource_device = static_cast<ID3D12Device *>(device_object);
+      const bool matches = resource_device == device_;
+      resource_device->Release();
+      return matches;
+    };
+    if (!belongs_to_queue_device(frame->left) || !belongs_to_queue_device(frame->right))
+      return DXGI_ERROR_INVALID_CALL;
+
+    auto *left = static_cast<MTLD3D12Resource *>(frame->left);
+    auto *right = static_cast<MTLD3D12Resource *>(frame->right);
+    D3D12_RESOURCE_DESC left_desc{}, right_desc{};
+    frame->left->GetDesc(&left_desc);
+    frame->right->GetDesc(&right_desc);
+    auto valid = [](const D3D12_RESOURCE_DESC &desc, uint32_t slice, uint32_t x, uint32_t y, uint32_t width,
+                    uint32_t height, uint32_t target_width, uint32_t target_height, uint32_t target_format) {
+      if (desc.Dimension != D3D12_RESOURCE_DIMENSION_TEXTURE2D || desc.SampleDesc.Count != 1 ||
+          slice >= desc.DepthOrArraySize || !width || !height || x > desc.Width || y > desc.Height ||
+          width > desc.Width - x || height > desc.Height - y || width > target_width || height > target_height)
+        return false;
+      const bool format_matches =
+          (desc.Format == DXGI_FORMAT_B8G8R8A8_UNORM && target_format == 80) ||
+          (desc.Format == DXGI_FORMAT_B8G8R8A8_UNORM_SRGB && target_format == 81) ||
+          (desc.Format == DXGI_FORMAT_R8G8B8A8_UNORM && target_format == 70) ||
+          (desc.Format == DXGI_FORMAT_R8G8B8A8_UNORM_SRGB && target_format == 71);
+      return format_matches && width <= target_width && height <= target_height;
+    };
+    if (!valid(left_desc, frame->leftArraySlice, frame->leftX, frame->leftY, frame->leftWidth, frame->leftHeight,
+               targets.width[0], targets.height[0], targets.pixelFormat[0]) ||
+        !valid(right_desc, frame->rightArraySlice, frame->rightX, frame->rightY, frame->rightWidth, frame->rightHeight,
+               targets.width[1], targets.height[1], targets.pixelFormat[1]))
+      return DXGI_ERROR_INVALID_CALL;
+    if (!left->texture || !right->texture || !left->texture->current() || !right->texture->current())
+      return E_INVALIDARG;
+
+    // Keep both the guest COM resources and their current DXMT allocation alive
+    // across the native compositor lease. The interface contract requires the
+    // guest to transition both resources to COMMON before this call.
+    WMT::Reference<WMT::Texture> left_texture(left->texture->current()->texture());
+    WMT::Reference<WMT::Texture> right_texture(right->texture->current()->texture());
+    if (!left_texture || !right_texture)
+      return E_INVALIDARG;
+
+    std::unique_lock<std::mutex> lease_lock(windows_vr_lease_mutex_);
+    // A released/static image may be submitted repeatedly without reacquisition.
+    // A newer ticket on the same native consumer event subsumes older leases.
+
+    auto scope = StartCommitting();
+    auto &cmdbuf = scope.inflight.cmdbuf;
+    const uint64_t producer_value = windows_vr_producer_value_.fetch_add(1, std::memory_order_relaxed) + 1;
+    cmdbuf.encodeSignalEvent(windows_vr_producer_event_, producer_value);
+
+    WMTWindowsVRRequestV2 request{};
+    request.abiVersion = WVR_COMPOSITOR_ABI_VERSION_V2;
+    request.structSize = sizeof(request);
+    request.status = WVRCompositorStatusInvalidArgument;
+    request.commandBuffer = cmdbuf.handle;
+    request.producerEvent = windows_vr_producer_event_.handle;
+    request.producerValue = producer_value;
+    request.frameID = frame->frameID;
+    request.timestampNanoseconds = frame->timestampNanoseconds;
+    request.targetGeneration = frame->targetGeneration;
+    request.leftTexture = left_texture.handle;
+    request.rightTexture = right_texture.handle;
+    request.leftSlice = frame->leftArraySlice;
+    request.leftX = frame->leftX;
+    request.leftY = frame->leftY;
+    request.leftWidth = frame->leftWidth;
+    request.leftHeight = frame->leftHeight;
+    request.rightSlice = frame->rightArraySlice;
+    request.rightX = frame->rightX;
+    request.rightY = frame->rightY;
+    request.rightWidth = frame->rightWidth;
+    request.rightHeight = frame->rightHeight;
+    const int32_t bridge_status = WMTWindowsVRBridgeCallV2(&request);
+    if (bridge_status != WVRCompositorStatusOK)
+      return bridge_status == WVRCompositorStatusNoFrameAvailable ? S_FALSE : E_FAIL;
+    if (!request.consumerEvent || !request.compositorTicket) {
+      if (request.consumerEvent)
+        WMT::Reference<WMT::SharedEvent> unused_event(request.consumerEvent);
+      return E_FAIL;
+    }
+
+    WMT::Reference<WMT::SharedEvent> consumer_event(request.consumerEvent); // adopts the bridge's retained handle
+    auto retain_resource = [](ID3D12Resource *resource) {
+      resource->AddRef();
+      return std::shared_ptr<ID3D12Resource>(resource, [](ID3D12Resource *value) { value->Release(); });
+    };
+    windows_vr_leases_[frame->left] = {retain_resource(frame->left), consumer_event, request.compositorTicket};
+    windows_vr_leases_[frame->right] = {retain_resource(frame->right), consumer_event, request.compositorTicket};
+    return S_OK;
+  }
+
+  HRESULT STDMETHODCALLTYPE WaitWindowsVRImage(ID3D12Resource *resource) final {
+    if (!resource)
+      return E_INVALIDARG;
+    WindowsVRImageLease lease;
+    {
+      std::lock_guard<std::mutex> lock(windows_vr_lease_mutex_);
+      auto found = windows_vr_leases_.find(resource);
+      if (found == windows_vr_leases_.end())
+        return S_OK;
+      lease = std::move(found->second);
+      windows_vr_leases_.erase(found);
+    }
+    auto scope = StartCommitting();
+    scope.inflight.cmdbuf.encodeWaitForEvent(lease.consumer_event, lease.ticket);
+    // StartCommitting commits on scope destruction. This queue wait is ordered
+    // before any subsequent command-list writes to the reacquired image.
+    return S_OK;
   }
 
