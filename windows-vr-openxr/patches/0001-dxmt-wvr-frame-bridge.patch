+  }
+  WVRSubmitStereoFrameV2 frame = {};
+  frame.abiVersion = WVR_COMPOSITOR_ABI_VERSION_V2; frame.structSize = sizeof(frame);
+  frame.producerFrameID = request->frameID; frame.producerTimestampNanoseconds = request->timestampNanoseconds;
+  frame.leftTexture = left; frame.rightTexture = right;
+  frame.producerReadyEvent = producer_event; frame.producerReadyValue = request->producerValue;
+  frame.targetGeneration = request->targetGeneration;
+  frame.leftSlice = request->leftSlice; frame.leftX = request->leftX; frame.leftY = request->leftY;
+  frame.leftWidth = request->leftWidth; frame.leftHeight = request->leftHeight;
+  frame.rightSlice = request->rightSlice; frame.rightX = request->rightX; frame.rightY = request->rightY;
+  frame.rightWidth = request->rightWidth; frame.rightHeight = request->rightHeight;
+  request->status = wvr_compositor_submit_stereo_frame_v2(&frame, &request->compositorTicket);
+  if (request->status == WVRCompositorStatusOK) request->consumerEvent = (uint64_t)(uintptr_t)consumer_event;
