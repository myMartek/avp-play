+  HRESULT STDMETHODCALLTYPE WaitWindowsVRImage(ID3D11Resource *resource) final {
+    if (!resource) return E_INVALIDARG;
+    WMT::Reference<WMT::SharedEvent> event;
+    std::shared_ptr<ID3D11Resource> retainedResource;
+    uint64_t ticket = 0;
+    {
+      std::lock_guard<std::mutex> lock(windows_vr_lease_mutex_);
+      auto found = windows_vr_leases_.find(resource);
+      if (found == windows_vr_leases_.end()) return S_OK;
+      retainedResource = std::move(found->second.resource);
+      event = found->second.event;
+      ticket = found->second.ticket; windows_vr_leases_.erase(found);
+    }
+    WMT::Reference<WMT::Event> waitEvent(event);
+    ctx_->EmitOP([event = std::move(waitEvent), retainedResource = std::move(retainedResource), ticket](ArgumentEncodingContext &enc) mutable {
+      enc.waitEvent(std::move(event), ticket);
