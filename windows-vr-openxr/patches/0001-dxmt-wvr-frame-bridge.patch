+static NTSTATUS
+_WMTWindowsVRBridgeCallV1(void *obj) {
+  struct unixcall_windows_vr_bridge_v1 *params = obj;
+  WMTWindowsVRRequestV1 *request = params->request.ptr;
+  if (!request || request->abiVersion != WVR_COMPOSITOR_ABI_VERSION ||
+      request->structSize != sizeof(*request))
+    return STATUS_INVALID_ADDRESS;
+  request->status = WVRCompositorStatusInvalidArgument;
+  if (wmtr_enabled()) {
+    request->status = WVRCompositorStatusUnsupportedABI;
+    return STATUS_SUCCESS;
+  }
+  switch (request->kind) {
+  case WMTWindowsVRRequestTargets:
+    request->targets.abiVersion = WVR_COMPOSITOR_ABI_VERSION;
+    request->targets.structSize = sizeof(request->targets);
+    request->status = wvr_compositor_copy_targets_v1(&request->targets);
+    break;
+  case WMTWindowsVRRequestReadiness:
+    request->readiness.abiVersion = WVR_COMPOSITOR_ABI_VERSION;
+    request->readiness.structSize = sizeof(request->readiness);
+    request->status = wvr_compositor_copy_readiness_v1(&request->readiness);
+    break;
+  case WMTWindowsVRRequestTracking:
+    request->tracking.abiVersion = WVR_COMPOSITOR_ABI_VERSION;
+    request->tracking.structSize = sizeof(request->tracking);
+    request->status = wvr_compositor_copy_frame_tracking_v1(&request->tracking);
+    break;
+  case WMTWindowsVRRequestController:
+    request->controller.abiVersion = WVR_COMPOSITOR_ABI_VERSION;
+    request->controller.structSize = sizeof(request->controller);
+    request->status = wvr_compositor_copy_controller_state_v1(request->role, &request->controller);
+    break;
+  case WMTWindowsVRRequestHaptic:
+    request->status = wvr_compositor_submit_haptic_v1(request->role, request->hapticAmplitude,
+      request->hapticFrequencyHz, request->hapticDurationSeconds, &request->hapticSequence);
+    break;
+  case WMTWindowsVRRequestSubmitStereo: {
+    WVRRenderTargetInfoV1 targets = {};
+    targets.abiVersion = WVR_COMPOSITOR_ABI_VERSION;
+    targets.structSize = sizeof(targets);
+    if (request->targetGeneration == 0 ||
+        wvr_compositor_copy_targets_v1(&targets) != WVRCompositorStatusOK ||
+        targets.generation != request->targetGeneration) {
+      request->status = WVRCompositorStatusIncompatibleTexture;
+      break;
+    }
+    id<MTLCommandBuffer> command_buffer = (id<MTLCommandBuffer>)(uintptr_t)request->commandBuffer;
+    id<MTLTexture> left = (id<MTLTexture>)(uintptr_t)request->leftTexture;
+    id<MTLTexture> right = (id<MTLTexture>)(uintptr_t)request->rightTexture;
+    id<MTLSharedEvent> producer_event = (id<MTLSharedEvent>)(uintptr_t)request->producerEvent;
+    id<MTLSharedEvent> consumer_event = (id<MTLSharedEvent>)wvr_compositor_copy_consumer_event_v1();
+    if (!command_buffer || !left || !right || !producer_event || !consumer_event) {
+      if (consumer_event) wvr_compositor_release_object_v1(consumer_event);
+      request->status = WVRCompositorStatusInvalidArgument;
+      break;
+    }
+    // DXMT already encoded producerReadyEvent at the end of this same command
+    // buffer. The host only appends the submission after that signal exists.
+    WVRSubmitStereoFrameV1 frame = {};
+    frame.abiVersion = WVR_COMPOSITOR_ABI_VERSION;
+    frame.structSize = sizeof(frame);
+    frame.producerFrameID = request->frameID;
+    frame.producerTimestampNanoseconds = request->timestampNanoseconds;
+    frame.leftTexture = left;
+    frame.rightTexture = right;
+    frame.producerReadyEvent = producer_event;
+    frame.producerReadyValue = request->producerValue;
+    request->status = wvr_compositor_submit_stereo_frame_v1(&frame, &request->compositorTicket);
+    if (request->status == WVRCompositorStatusOK)
+      request->consumerEvent = (uint64_t)(uintptr_t)consumer_event;
+    else
+      wvr_compositor_release_object_v1(consumer_event);
+    break;
+  }
+  default:
+    request->status = WVRCompositorStatusUnsupportedABI;
+    break;
+  }
   return STATUS_SUCCESS;
 }
 
