+  HRESULT STDMETHODCALLTYPE SubmitWindowsVRFrameV2(const WVRDXMTSubmitFrameV2 *frame) final {
+    if (!frame || !frame->left || !frame->right || !frame->targetGeneration) return E_INVALIDARG;
+    WVRDXMTTargetInfoV1 targets{};
+    if (FAILED(GetWindowsVRTargets(&targets)) || targets.generation != frame->targetGeneration)
+      return DXGI_ERROR_INVALID_CALL;
+    D3D11_RESOURCE_DIMENSION leftDimension{}, rightDimension{};
+    frame->left->GetType(&leftDimension); frame->right->GetType(&rightDimension);
+    if (leftDimension != D3D11_RESOURCE_DIMENSION_TEXTURE2D || rightDimension != D3D11_RESOURCE_DIMENSION_TEXTURE2D)
+      return E_INVALIDARG;
+    D3D11_TEXTURE2D_DESC leftDesc{}, rightDesc{};
+    static_cast<ID3D11Texture2D *>(frame->left)->GetDesc(&leftDesc);
+    static_cast<ID3D11Texture2D *>(frame->right)->GetDesc(&rightDesc);
+    auto valid = [](const D3D11_TEXTURE2D_DESC &d, uint32_t slice, uint32_t x, uint32_t y,
+                    uint32_t width, uint32_t height, uint32_t targetWidth, uint32_t targetHeight) {
+      return d.SampleDesc.Count == 1 && slice < d.ArraySize && width && height &&
+          x <= d.Width && y <= d.Height && width <= d.Width - x && height <= d.Height - y &&
+          width <= targetWidth && height <= targetHeight;
+    };
+    auto formatMatches = [](DXGI_FORMAT format, uint32_t metalFormat) {
+      return (format == DXGI_FORMAT_B8G8R8A8_UNORM && metalFormat == 80) ||
+             (format == DXGI_FORMAT_B8G8R8A8_UNORM_SRGB && metalFormat == 81) ||
+             (format == DXGI_FORMAT_R8G8B8A8_UNORM && metalFormat == 70) ||
+             (format == DXGI_FORMAT_R8G8B8A8_UNORM_SRGB && metalFormat == 71);
+    };
+    if (!valid(leftDesc, frame->leftArraySlice, frame->leftX, frame->leftY, frame->leftWidth,
+               frame->leftHeight, targets.width[0], targets.height[0]) ||
+        !valid(rightDesc, frame->rightArraySlice, frame->rightX, frame->rightY, frame->rightWidth,
+               frame->rightHeight, targets.width[1], targets.height[1]) ||
+        !formatMatches(leftDesc.Format, targets.pixelFormat[0]) ||
+        !formatMatches(rightDesc.Format, targets.pixelFormat[1])) return DXGI_ERROR_INVALID_CALL;
+    auto leftTexture = static_cast<D3D11ResourceCommon *>(frame->left)->texture();
+    auto rightTexture = static_cast<D3D11ResourceCommon *>(frame->right)->texture();
+    if (!leftTexture || !rightTexture) return E_INVALIDARG;
+    WMTWindowsVRRequestV2 layout{};
+    layout.targetGeneration = frame->targetGeneration; layout.frameID = frame->frameID;
+    layout.timestampNanoseconds = frame->timestampNanoseconds;
+    layout.leftSlice = frame->leftArraySlice; layout.leftX = frame->leftX; layout.leftY = frame->leftY;
+    layout.leftWidth = frame->leftWidth; layout.leftHeight = frame->leftHeight;
+    layout.rightSlice = frame->rightArraySlice; layout.rightX = frame->rightX; layout.rightY = frame->rightY;
+    layout.rightWidth = frame->rightWidth; layout.rightHeight = frame->rightHeight;
+    auto result = std::make_shared<WindowsVRSubmissionResult>();
+    ctx_->EmitOP([leftTexture = std::move(leftTexture), rightTexture = std::move(rightTexture),
+                  frameCopy = layout, result](ArgumentEncodingContext &enc) mutable {
+      enc.queueWindowsVRSubmission(leftTexture->current()->texture(), rightTexture->current()->texture(),
+                                     frameCopy, result);
+    });
+    ctx_->Commit();
+    std::unique_lock<std::mutex> resultLock(result->mutex);
+    if (!result->changed.wait_for(resultLock, std::chrono::seconds(2), [&] { return result->completed; })) {
+      result->cancelled = true;
+      return HRESULT_FROM_WIN32(ERROR_TIMEOUT);
+    }
+    if (result->status != WVRCompositorStatusOK || !result->consumerEvent || !result->ticket)
+      return result->status == WVRCompositorStatusNoFrameAvailable ? S_FALSE : E_FAIL;
+    WMT::Reference<WMT::SharedEvent> event(result->consumerEvent);
+    result->eventClaimed = true;
+    const uint64_t ticket = result->ticket;
+    resultLock.unlock();
+    std::lock_guard<std::mutex> leaseLock(windows_vr_lease_mutex_);
+    windows_vr_leases_[frame->left] = {RetainWindowsVRResource(frame->left), event, ticket};
+    windows_vr_leases_[frame->right] = {RetainWindowsVRResource(frame->right), event, ticket};
+    return S_OK;
+  }
