+echo "=== Building unpatched wineserver sources from Makefile.in ==="
+while IFS= read -r rel_src; do
+    source_obj="$(basename "$rel_src" .c).o"
+    replaced=0
+    for entry in "${PATCHED_FILES[@]}"; do
+        IFS=: read -r _ _ old_obj <<< "$entry"
+        if [[ "$old_obj" == "$source_obj" ]]; then replaced=1; break; fi
+    done
+    if (( replaced )); then continue; fi
+    compile_one "$WINE_SRC/server/$rel_src" "${source_obj%.o}"
+done < <(python3 - "$WINE_SRC/server/Makefile.in" <<'PY'
+import pathlib, sys
+path = pathlib.Path(sys.argv[1])
+lines = path.read_text(encoding="utf-8").splitlines()
+active = False
+sources = []
+for line in lines:
+    if not active:
+        if line.startswith("SOURCES ="):
+            active = True
+            line = line.split("=", 1)[1]
+        else:
+            continue
+    continued = line.rstrip().endswith("\\")
+    for token in line.replace("\\", " ").split():
+        if token.endswith(".c"):
+            sources.append(token)
+    if not continued:
+        break
+if not sources:
+    raise SystemExit(f"No C sources found in {path} SOURCES list")
+for source in sources:
+    print(source)
+PY
+)
+
