diff --git a/app/Madeira/WineProcessBridge.m b/app/Madeira/WineProcessBridge.m
--- a/app/Madeira/WineProcessBridge.m
+++ b/app/Madeira/WineProcessBridge.m
@@ -290,6 +290,48 @@
 
 static pthread_t g_wine_thread;
 static volatile int g_wine_running = 0;
+
+// Project-owned launch profile; the app configures it before starting this
+// thread and the runtime permits only one launch per process.
+static pthread_mutex_t g_launch_profile_mutex = PTHREAD_MUTEX_INITIALIZER;
+static char *g_launch_executable = NULL;
+static char *g_launch_workdir = NULL;
+static char *g_launch_arguments[64] = {0};
+static int g_launch_argument_count = -1;
+static int g_launch_force_aarch64 = 0;
+
+int wine_process_configure_launch(const char *executable_windows_path,
+                                  const char *working_directory_windows_path,
+                                  int argc, const char *const *argv,
+                                  int force_aarch64)
+{
+    if (!executable_windows_path || !*executable_windows_path ||
+        strlen(executable_windows_path) >= 512 || argc < 0 || argc > 64 ||
+        (argc && !argv)) return -1;
+    char *exe = strdup(executable_windows_path);
+    char *cwd = working_directory_windows_path && *working_directory_windows_path
+        ? strdup(working_directory_windows_path) : NULL;
+    char *args[64] = {0};
+    if (!exe || ((working_directory_windows_path && *working_directory_windows_path) && !cwd)) {
+        free(exe); free(cwd); return -1;
+    }
+    for (int i = 0; i < argc; i++) {
+        if (!argv[i] || strlen(argv[i]) > 4096 || !(args[i] = strdup(argv[i]))) {
+            for (int j = 0; j < argc; j++) free(args[j]);
+            free(exe); free(cwd); return -1;
+        }
+    }
+    pthread_mutex_lock(&g_launch_profile_mutex);
+    free(g_launch_executable); free(g_launch_workdir);
+    for (int i = 0; i < 64; i++) { free(g_launch_arguments[i]); g_launch_arguments[i] = NULL; }
+    g_launch_executable = exe;
+    g_launch_workdir = cwd;
+    for (int i = 0; i < argc; i++) g_launch_arguments[i] = args[i];
+    g_launch_argument_count = argc;
+    g_launch_force_aarch64 = force_aarch64 != 0;
+    pthread_mutex_unlock(&g_launch_profile_mutex);
+    return 0;
+}
 
